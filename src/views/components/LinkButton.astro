---
interface Props {
    link: string;
    subtext: string;
    label: string;
    class?: string;
}

const { link, subtext, label, class: className = "px-2 py-1" } = Astro.props;
---

<a href={link} target="_blank" class:list={["bg-[#010409] rounded-lg flex flex-row items-center justify-center gap-2 text-white font-noto-sans font-medium border border-white", className]}>
    <slot/>

    <div class="flex flex-col items-start justify-center tracking-wide">
        <span class="text-[0.5rem] tracking-wider">{subtext}</span>
        {label}
    </div>
</a>
