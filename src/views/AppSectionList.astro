---
import type { AppSection } from '@model/app';
import { platforms } from '@model/platforms';

import FeatureCarousel from './components/FeatureCarousel.astro';
import FeatureFrames from './components/FeatureFrames.astro';

interface Props {
    sections: AppSection[]
}

const { sections } = Astro.props
---

<main id="section-list" class="w-full flex flex-col gap-6 my-8">
    {
        sections.map((section, index) => (
            <section id={`section-${section.id}`} class="w-full flex flex-col items-center gap-4">
                <div class="w-full section-header flex flex-col items-start justify-center gap-4 px-4 md:px-12 lg:px-24">
                    <strong class="font-montserrat font-normal text-text text-2xl">Section {index + 1}: { section.title }</strong>
                    <div class="w-full flex flex-row items-center justify-start gap-4">
                        <i class={`${platforms.find((platform) => platform.name == section.platform)?.icon} text-neutral-400`} ></i>
                        <span class="font-ubuntu-mono font-normal text-text text-lg">{ section.description }</span>
                    </div>
                </div>

                {
                    section.feature_type == "slides" ? (
                        <FeatureCarousel features={section.features} />
                    ) : (
                        <FeatureFrames section_id={section.id} features={section.features} />
                    )
                }
            </section>
        ))
    }
</main>

<script>
    import Swiper from "swiper";

    (async() => {
        new Swiper(".swiper", { 
            grabCursor: true,
            centeredSlides: true,
            slidesPerView: "auto",
            spaceBetween: 100,
            direction: 'horizontal',
            loop: false,
            keyboard: {
                enabled: true,
            },
            mousewheel: {
                enabled: true,
            },
        });
    })();
</script>